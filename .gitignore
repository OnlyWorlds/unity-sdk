# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never commit these -- Unity regenerates them, and they carry machine-local paths
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.slnx

# Asset meta files for ignored folders (Unity emits these for Library/ etc.)
/[Aa]ssets/AssetStoreTools*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Test-runner leftovers. Unity's performance-testing package writes these into
# Assets/Resources on any run and they are machine-local run state, not project
# data -- they appeared as untracked files after a test pass and would otherwise
# ride along in an unrelated commit.
/[Aa]ssets/Resources/PerformanceTestRunInfo.json*
/[Aa]ssets/Resources/PerformanceTestRunSettings.json*
.utmp/

# Credentials -- never, under any circumstances
*.env
.env
secrets/

# Synced world caches. These are generated by OWSync from whatever world a
# developer connected to -- someone else's data, often licensed IP, sometimes
# large (a 1,087-element world is ~1.8MB). A cache is a local artifact, never a
# committed one. The default sync target is Assets/OnlyWorlds/.
/[Aa]ssets/OnlyWorlds/
/[Aa]ssets/OnlyWorlds.meta
